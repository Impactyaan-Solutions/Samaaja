# Local development only: where `npm run dev` sends API calls.
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000

# Shows the mobile-number + OTP login and signup forms. When this is not
# 'true' those forms are hidden and only the alternative sign-in is shown.
# Set it explicitly at build time - an unset value is treated as false.
VITE_USE_MOBILE_NUMBER_AUTH=true

# Not used by the website build - nothing reads it. Kept because the
# Android build will need it: a phone has no "same site" to call, so it
# needs the full server address. See the note in api.js.
VITE_API_BASE_URL=

# Also unused today: auth.js reads these into getAPITokenFromEnv(), which
# nothing calls. The live token path is getAPITokenFromStorage(), which
# uses the api_key/api_secret returned at login on a phone.
VITE_API_KEY=
VITE_API_SECRET=
